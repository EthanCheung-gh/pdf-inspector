{
  "name": "pdf-inspector",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:main": "tsc -p tsconfig.node.json",
    "build:web": "vite build --config vite.web.config.ts",
    "build:web-server": "esbuild server/web-server.ts --bundle --platform=node --format=esm --outfile=dist-web-server/server.mjs",
    "web": "npm run build:web && npm run build:web-server && node dist-web-server/server.mjs",
    "web:start": "node dist-web-server/server.mjs",
    "start": "npm run build:main && electron .",
    "preview": "vite preview",
    "icon": "node scripts/generate-icon.js",
    "freeze:sidecar": "sh scripts/freeze-sidecar.sh",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "pdfjs-dist": "^4.8.69",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^28.3.0",
    "electron-builder": "^24.13.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.28.0",
    "vitest": "^2.0.0"
  }
}
