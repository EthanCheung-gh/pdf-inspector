{
  "$schema": "https://opencode.ai/config.json",

  // Model assignments for Superpowers agents
  "agent": {
    // ✍️ Plan writer — Deepseek V4 Flash
    "superpowers-plan-writer": {
      "model": "deepseek/deepseek-v4-flash"
    },

    // 🔧 Build/implementer — Kimi K3
    "superpowers-implementer": {
      "model": "kimi/kimi-k3"
    },

    // 👁️ Code reviewer — Deepseek V4 Pro
    "superpowers-code-reviewer": {
      "model": "deepseek/deepseek-v4-pro"
    },

    // 🔍 Explore agent — Deepseek V4 Flash
    "explore": {
      "model": "deepseek/deepseek-v4-flash"
    },

    // Built-in agents mirror the same routing.
    "plan": {
      "model": "deepseek/deepseek-v4-flash"
    },
    "build": {
      "model": "kimi/kimi-k3"
    }
  }
}
